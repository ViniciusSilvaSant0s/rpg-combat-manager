// Esquema definido pelas migrations do projeto; a aplicação no banco é manual.
Table app_users {
  id number [pk, increment, not null]
  firebase_uid "varchar2(128 char)" [not null, unique]
  email "varchar2(320 char)"
  display_name "varchar2(255 char)"
  nickname "varchar2(20 char)" [not null, note: 'De 3 a 20 letras ASCII, números ou sublinhados.']
  birth_date date [not null]
  created_at "timestamp with time zone" [not null, default: `SYSTIMESTAMP`]
  updated_at "timestamp with time zone" [not null, default: `SYSTIMESTAMP`]

  indexes {
    (`LOWER(nickname)`) [unique, name: 'app_users_nickname_uk', note: 'Unicidade sem distinção entre maiúsculas e minúsculas.']
    email [name: 'app_users_email_ix']
  }

  checks {
    `REGEXP_LIKE(nickname, '^[A-Za-z0-9_]{3,20}$', 'c')` [name: 'app_users_nickname_ck']
  }
}

Table combats {
  id number [pk, increment]
  user_id number [not null, ref: > app_users.id]
  title "varchar2(255 char)" [not null]
  description "varchar2(4000 char)"
  started "number(1)" [not null, default: 0]
  current_participant_id number [note: 'Participação da vez no próprio combate; pode ser nula.']
  version number [not null, default: 1]
  created_at "timestamp with time zone" [not null, default: `SYSTIMESTAMP`]
  updated_at "timestamp with time zone" [not null, default: `SYSTIMESTAMP`]
  indexes { user_id [name: 'combats_user_id_ix'] }
}

Table combat_participants {
  id number [pk, increment]
  combat_id number [not null, ref: > combats.id]
  combatant_id number [not null, ref: > combatants.id]
  position number [not null, note: 'Ordem de inclusão, preservada para desempates de iniciativa.']
  current_hit_points "number(10)" [not null]
  additional_hit_points "number(16)" [note: 'Limitado ao maior inteiro seguro do JavaScript.']
  initiative "number(10)"
  natural_initiative "number(2)"
  indexes {
    (combat_id, id) [unique, name: 'combat_participants_combat_id_uk']
    combat_id [name: 'combat_participants_combat_ix']
    combatant_id [name: 'combat_participants_combatant_ix']
  }
}

Table combat_participant_conditions {
  participant_id number [not null, ref: > combat_participants.id]
  condition_id "varchar2(64 char)" [not null]
  indexes { (participant_id, condition_id) [pk, name: 'combat_participant_conditions_pk'] }
}

Ref: combats.(id, current_participant_id) > combat_participants.(combat_id, id)

Table combatants {
  id number [pk, increment]
  user_id number [not null, ref: > app_users.id]
  name "varchar2(255 char)" [not null]
  type "varchar2(6 char)" [not null]
  character_id "varchar2(64 char)"
  maximum_hit_points "number(10)" [not null]
  armor_class "number(10)" [not null]
  created_at "timestamp with time zone" [not null, default: `SYSTIMESTAMP`]
  updated_at "timestamp with time zone" [not null, default: `SYSTIMESTAMP`]
  indexes { user_id [name: 'combatants_user_id_ix'] }
  checks {
    `type IN ('player', 'npc')`
    `maximum_hit_points >= 0`
    `armor_class >= 0`
  }
}

Table friendships {
  low_id number [not null, ref: > app_users.id]
  high_id number [not null, ref: > app_users.id]
  sender_id number [not null, ref: > app_users.id]
  status "varchar2(8 char)" [not null]
  indexes {
    (low_id, high_id) [pk, name: 'friendships_pk']
    high_id [name: 'friendships_high_ix']
    sender_id [name: 'friendships_sender_ix']
  }
  checks {
    `low_id < high_id` [name: 'friendships_order_ck']
    `sender_id IN (low_id, high_id)` [name: 'friendships_sender_ck']
    `status IN ('pending', 'accepted')` [name: 'friendships_status_ck']
  }
}
